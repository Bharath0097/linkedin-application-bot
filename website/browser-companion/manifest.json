{
  "manifest_version": 3,
  "name": "StratEdge Application Bot Companion",
  "version": "1.2.1",
  "description": "Fills the job applications you approve in the StratEdge portal, in your own browser, on employer sites you allow.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "alarms",
    "unlimitedStorage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "StratEdge Application Bot Companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "externally_connectable": {
    "matches": [
      "https://stratedgeitconsulting.com/*",
      "https://*.stratedgeitconsulting.com/*"
    ]
  },
  "key": ""
}
