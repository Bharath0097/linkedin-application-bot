# Settings for the job-portal server (python -m jobserver). Copy to .env and edit.
# Shared secret; set the same value as 'jobs_key' in website/api/config.php.
JOBSERVER_API_KEY=change-me-to-a-long-random-string
JOBSERVER_HOST=127.0.0.1
JOBSERVER_PORT=8765
# Where the database, encryption key, saved portal sessions and resumes live.
JOBSERVER_DATA=./data/jobserver
# firefox or chrome (the browser and its driver must be installed on the server).
JOBSERVER_BROWSER=firefox
JOBSERVER_HEADLESS=true
# Collect jobs automatically every N minutes (0 = only when started from the portal).
JOBSERVER_SCRAPE_EVERY_MIN=180
# Result pages per search and searches per run (keep these small to stay polite with the portals).
JOBSERVER_MAX_PAGES=2
JOBSERVER_MAX_QUERIES=24
# Jobs older than this are removed unless a consultant saved them.
JOBSERVER_JOB_MAX_AGE_DAYS=45
# Matches below this score (0-100) are not shown.
JOBSERVER_MIN_SCORE=25
JOBSERVER_DEFAULT_LOCATION=United States
